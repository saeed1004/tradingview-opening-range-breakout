//@version=5
// Opening Range Breakout — portfolio demo (educational, not financial advice)
// Rules: the high/low of an opening-range session; buy stop above the high (+offset),
// sell stop below the low (-offset); fixed TP/SL in points; one trade per day (OCO);
// everything is closed at the end of the trading window. Levels are shown top-right.
strategy("Opening Range Breakout (demo)", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     calc_on_order_fills = false, process_orders_on_close = false)

// ---------- inputs ----------
rangeSess  = input.session("1030-1100", "Opening range (high/low taken here)")
tradeSess  = input.session("1100-1745", "Trading window (entries allowed; flat at its end)")
tz         = input.string("Asia/Kuala_Lumpur", "Timezone (IANA)")
ptSize     = input.float(1.0,  "Point size (price units per 1 pt)", minval = 0.0000001)
offsetPts  = input.float(1.0,  "Entry offset (pts)", minval = 0)
tpPts      = input.float(5.0,  "Take profit (pts)", minval = 0.1)
slPts      = input.float(7.0,  "Stop loss (pts)",   minval = 0.1)
onePerDay  = input.bool(true,  "Only one trade per day")
showTable  = input.bool(true,  "Show levels table")

// ---------- session state ----------
inRange = not na(time(timeframe.period, rangeSess, tz))
inTrade = not na(time(timeframe.period, tradeSess, tz))
dayNum  = dayofmonth(time, tz)
newDay  = dayNum != dayNum[1]

var float rHi = na
var float rLo = na
var bool  rangeDone   = false
var bool  tradedToday = false

if newDay
    rHi := na
    rLo := na
    rangeDone   := false
    tradedToday := false

if inRange
    rHi := na(rHi) ? high : math.max(rHi, high)
    rLo := na(rLo) ? low  : math.min(rLo, low)

if not inRange and inRange[1] and not na(rHi)
    rangeDone := true

// ---------- levels ----------
buyStop  = rHi + offsetPts * ptSize
sellStop = rLo - offsetPts * ptSize
buyTP    = buyStop  + tpPts * ptSize
buySL    = buyStop  - slPts * ptSize
sellTP   = sellStop - tpPts * ptSize
sellSL   = sellStop + slPts * ptSize

if strategy.position_size != 0
    tradedToday := true

// ---------- orders ----------
canEnter = rangeDone and inTrade and strategy.position_size == 0 and not (onePerDay and tradedToday)

if canEnter
    strategy.entry("Long",  strategy.long,  stop = buyStop,  oca_name = "ORB", oca_type = strategy.oca.cancel)
    strategy.entry("Short", strategy.short, stop = sellStop, oca_name = "ORB", oca_type = strategy.oca.cancel)
else if strategy.position_size == 0
    strategy.cancel("Long")
    strategy.cancel("Short")

strategy.exit("Long exit",  "Long",  stop = buySL,  limit = buyTP)
strategy.exit("Short exit", "Short", stop = sellSL, limit = sellTP)

if not inTrade and inTrade[1]
    strategy.cancel_all()
    strategy.close_all(comment = "End of window")

// ---------- drawing ----------
showLv = rangeDone
plot(showLv ? rHi : na,      "Range high", color.new(color.gray, 0),  1, plot.style_linebr)
plot(showLv ? rLo : na,      "Range low",  color.new(color.gray, 0),  1, plot.style_linebr)
plot(showLv ? buyStop : na,  "Buy stop",   color.new(color.green, 0), 2, plot.style_linebr)
plot(showLv ? sellStop : na, "Sell stop",  color.new(color.red, 0),   2, plot.style_linebr)
bgcolor(inRange ? color.new(color.blue, 90) : na, title = "Opening range")

var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 15), border_width = 1)
f(x) => na(x) ? "-" : str.tostring(x, format.mintick)
if showTable and barstate.islast
    table.cell(tb, 0, 0, "Opening Range Breakout", text_color = color.white)
    table.cell(tb, 1, 0, rangeDone ? "ready" : "waiting", text_color = rangeDone ? color.lime : color.orange)
    table.cell(tb, 0, 1, "Range high / low", text_color = color.white)
    table.cell(tb, 1, 1, f(rHi) + " / " + f(rLo), text_color = color.white)
    table.cell(tb, 0, 2, "BUY STOP", text_color = color.lime)
    table.cell(tb, 1, 2, f(buyStop), text_color = color.lime)
    table.cell(tb, 0, 3, "Buy TP / SL", text_color = color.lime)
    table.cell(tb, 1, 3, f(buyTP) + " / " + f(buySL), text_color = color.lime)
    table.cell(tb, 0, 4, "SELL STOP", text_color = color.red)
    table.cell(tb, 1, 4, f(sellStop), text_color = color.red)
    table.cell(tb, 0, 5, "Sell TP / SL", text_color = color.red)
    table.cell(tb, 1, 5, f(sellTP) + " / " + f(sellSL), text_color = color.red)
    table.cell(tb, 0, 6, "Traded today", text_color = color.white)
    table.cell(tb, 1, 6, tradedToday ? "yes" : "no", text_color = color.white)
